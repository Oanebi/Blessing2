package main

import (
	"fmt"
	"net/http"
	"strings"
)

func formhandler(w http.ResponseWriter, r *http.Request) {
	if r.Method == http.MethodPost {

		contentType := r.Header.Get("Content-Type")
		if !strings.HasPrefix(contentType, "application/x-www-form-urlencoded") {
			http.Error(w, "content-Type must be application/x-www-form-urlencoded", http.StatusUnsupportedMediaType)
			return
		}
		err := r.ParseForm()
		if err != nil {
			http.Error(w, "failed to parse form", http.StatusBadRequest)
			return
		}
		username := r.FormValue("username")
		language := r.FormValue("language")
		if username == "" {
			http.Error(w, "username is required", http.StatusBadRequest)
			return
		}
		if language == "" {
			http.Error(w, "language is required", http.StatusBadRequest)
			return
		}
		fmt.Fprintf(w, "Hello %s, you are coding in %s!", username, language)
	} else {
		http.Error(w, "not a post method", http.StatusMethodNotAllowed)
		return
	}
}
func main() {
	http.HandleFunc("/form", formhandler)
	fmt.Println("server listening at port:8080")
	http.ListenAndServe(":8080", nil)
}
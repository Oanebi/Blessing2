package main

import (
	"errors"
	"os"
	"strings"
)

func LoadBanner(fileName string) (map[rune][]string, error) {
	graphic := make(map[rune][]string)

	fontFile, err := os.ReadFile(fileName)

	if err != nil {
		return nil, err
	}

	if len(fontFile) == 0 {
		return nil, errors.New("empty file")
	}

	fontFileLines := strings.Split(string(fontFile), "\n")

	//fontFileLines = fontFileLines[1:]
	if len(fontFileLines) != 856 {
		return nil, errors.New("invalid file content")
	}

	for i := ' '; i <= '~'; i++ {
		start := int(i-32) * 9
		end := start + 8
		graphic[i] = fontFileLines[start:end]
	}
	return graphic, nil
}

package main

import (
	"bufio"
	"fmt"
	"os"
)

func help() {
	fmt.Println("take two integers, indicate operator needed to run the program")
	fmt.Println("---help---")
}

func main() {
	reader := bufio.NewReader(os.Stdin)

	for {
		var a, b int
		var operator string

		fmt.Println("Enter the first number:")
		input, _ := reader.ReadString('\n')
		_, err := fmt.Sscan(input, &a)
		if err != nil {
			fmt.Println("input digit")
			continue
		}

		fmt.Println("Enter operator (+,-,/,*,help,q):")
		input, _ = reader.ReadString('\n')
		fmt.Sscan(input, &operator)

		fmt.Println("Enter the second number:")
		input, _ = reader.ReadString('\n')
		_, err = fmt.Sscan(input, &b)
		if err != nil {
			fmt.Println("input digit")
			continue
		}

		switch operator {

		case "+":
			fmt.Println(a, "+", b, "=", a+b)

		case "-":
			fmt.Println(a, "-", b, "=", a-b)

		case "*":
			fmt.Println(a, "*", b, "=", a*b)

		case "/":
			if b != 0 {
				fmt.Println(a, "/", b, "=", a/b)
			} else {
				fmt.Println("Error: not divisible")
			}

		case "help":
			help()
			continue

		case "q":
			fmt.Println("Goodbye")
			return

		default:
			fmt.Printf("%q is an invalid operator\n", operator)

			var response string
			fmt.Println("Do you want to continue (yes/no):")
			input, _ = reader.ReadString('\n')
			fmt.Sscan(input, &response)

			if response != "yes" {
				fmt.Println("Rest, continue next time")
				return
			}
		}
	}
}

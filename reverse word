package main

import (
	"fmt"
	"strings"
)

func reverseword(s string) string {
	text := strings.Fields(s)
	for i, j := 0, len(text)-1; i < j; i, j = i+1, j-1 {
		text[i], text[j] = text[j], text[i]
	}
	return strings.Join(text, " ")
}

func main() {
	fmt.Println(reverseword("Hello How Are You"))
}
